<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
     "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The bundle’s identifier -->
    <key>CFBundleIdentifier</key>
    <string>com.yourcompany.MyVoxelGame</string>

    <!-- “MyVoxelGame” as the name that Finder will show -->
    <key>CFBundleName</key>
    <string>MyVoxelGame</string>

    <!-- Version and build numbers (you can bump these as needed) -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>

    <!-- The executable’s filename inside Contents/MacOS/ -->
    <key>CFBundleExecutable</key>
    <string>MyVoxelGame</string>

    <!-- Require at least macOS 12.7.6 -->
    <key>LSMinimumSystemVersion</key>
    <string>12.7.6</string>

    <!-- This allows retina, transparency, etc. (optional) -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- macOS Game Mode (macOS 14+): the system turns it on for an app in a
         games category that is running full screen (a native full-screen
         Space, which ToggleFullscreen uses on macOS). It gives the game
         CPU/GPU scheduling priority over background work and doubles the
         Bluetooth sampling rate for controllers and AirPods. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.games</string>
    <key>GCSupportsGameMode</key>
    <true/>
  </dict>
</plist>