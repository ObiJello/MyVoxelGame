# Sentry auth (contains secret token)
.sentryclirc

# Ignore CMake build folders
build/
build-*/
cmake-build-*/

# CLion / IntelliJ files
.idea/
*.iml

# VS Code
.vscode/

# macOS system files
.DS_Store

# Ninja filesystem lock
.ninja_deps
.ninja_log

# Editor backups / swap files
*~
*.swp
*.swo

# Compiled objects / libraries / executables
*.o
*.a
*.so
*.dylib

# CMake generated files
CMakeCache.txt
CMakeFiles/
compile_commands.json

# My own ignore
depreciated/
decompiled_net/
decompiled_com/

# Portal SDK source + game assets (vendored locally for reference, not
# part of the repo — multi-GB and licensed separately by Valve)
Portal code/
Portal-Root/

# Windows build number (platform-specific counter, not shared)
tools/game_build_number_win

# Boost download artifacts (from CMake FetchContent/system Boost)
libs/
more/
sdadas
tools/auto_index/
tools/bcp/
tools/boost_install/
tools/boostbook/
tools/boostdep/
tools/check_build/
tools/cmake/
tools/docca/
tools/inspect/
tools/litre/
tools/quickbook/

# Prebuilt Tracy CLI tools (tracy-capture, tracy-csvexport) — 15 MB of
# binaries, rebuildable from cmake-build-tracy/_deps/tracy-src/{capture,csvexport}
tools/tracy/

# Instruments recordings from tools/play.sh --gpu-trace (hundreds of MB) and
# the XML tables tools/gpu_report.py exports next to them
*.trace/
*.trace.export/

# Profiling artifacts — Tracy captures and CSV plot exports run to 50-110 MB,
# over GitHub's file limits (a push was rejected for plots.csv on 2026-09-05).
*.tracy
plots.csv

# Mod source trees cloned for porting reference (Twilight Forest, The Aether)
mods_reference/

# Minecraft's sound assets (~370 MB of Mojang files), copied from the local
# Minecraft install by tools/extract_mc_sounds.py. The engine's own sound
# overlays (assets/sound_overlays/) ARE tracked.
/assets/sounds/
/assets/sounds.json
