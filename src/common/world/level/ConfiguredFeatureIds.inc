// File: src/common/world/level/ConfiguredFeatureIds.inc
//
// Every configured feature the terrain library carries that can be run
// against the live world (server/level/LiveFeatureLevel.cpp, /place feature
// and the growers), as one X-macro so the server's id -> feature table and
// the client's /place completion read the same list:
//
//     CONFIGURED_FEATURE(id, LibraryClass, STATIC)
//
// `id` is MC's registry key (Registries.CONFIGURED_FEATURE: the static's
// name lower-cased under minecraft:), the engine's own dimensions under
// their namespaces (hush:, aether:). LibraryClass::STATIC is the library's
// pointer in minecraft::data::worldgen::features, filled by
// BiomeFeatureRegistry::bootstrap. The Twilight Forest's features are not
// listed: the library registers them at bootstrap under their JSON ids
// (TwilightFeatureRegistry), and LiveFeatureLevel resolves those there.
//
// Vanilla 26.3 keys the library does not carry (not placeable here):
// crimson_forest_vegetation_bonemeal, end_gateway_delayed,
// nether_sprouts_bonemeal, patch_crimson_roots, patch_fire, patch_soul_fire,
// pile_hay, pile_ice, pile_melon, pile_pumpkin, pile_snow,
// twisting_vines_bonemeal, warped_forest_vegetation_bonemeal.
//
// No include guard: included more than once with different definitions.
